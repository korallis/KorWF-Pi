{
  "name": "korwf-pi",
  "version": "0.1.0",
  "description": "A Jev-assisted autonomous development workflow package for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "src",
    "resources",
    "docs/platform-support.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:spec",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test:spec": "node --experimental-strip-types --test \"test/workflow/*.test.mjs\" \"test/workflow/*.test.ts\"",
    "check:notices": "node scripts/check-third-party-notices.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typebox": "^1.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
